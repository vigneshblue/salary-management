<div class="pagination-container">
  <div class="pagination-info">
    <% if @total_count.positive? && @from_index.positive? %>
      Showing <strong><%= number_with_delimiter(@from_index) %></strong> to <strong><%= number_with_delimiter(@to_index) %></strong> of <strong><%= number_with_delimiter(@total_count) %></strong> employees
    <% else %>
      Showing 0 of <%= number_with_delimiter(@total_count) %> employees
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="pagination-controls" aria-label="Employees pagination">
      <% if @page > 1 %>
        <%= link_to "‹", employees_path(page: @page - 1, per_page: @per_page), class: "pagination-btn pagination-prev", aria: { label: "Previous page" } %>
      <% else %>
        <span class="pagination-btn pagination-disabled" aria-hidden="true">‹</span>
      <% end %>

      <% pagination_page_numbers(@page, @total_pages).each do |p| %>
        <% if p == :gap %>
          <span class="pagination-gap">…</span>
        <% elsif p == @page %>
          <span class="pagination-btn pagination-active" aria-current="page"><%= number_with_delimiter(p) %></span>
        <% else %>
          <%= link_to number_with_delimiter(p), employees_path(page: p, per_page: @per_page), class: "pagination-btn" %>
        <% end %>
      <% end %>

      <% if @page < @total_pages %>
        <%= link_to "›", employees_path(page: @page + 1, per_page: @per_page), class: "pagination-btn pagination-next", aria: { label: "Next page" } %>
      <% else %>
        <span class="pagination-btn pagination-disabled" aria-hidden="true">›</span>
      <% end %>
    </nav>
  <% end %>
</div>
