<% content_for :title, "#{@employee.name} — ACME HR" %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= @employee.name %> <span class="page-subtitle"><%= @employee.employee_number %></span></h1>
    <p class="page-subtitle">Employee Details</p>
  </div>
  <div style="display: flex; gap: 8px;">
    <%= link_to "Edit Employee", edit_employee_path(@employee), class: "btn btn-primary" %>
    <%= link_to "← Back to Employees", employees_path, class: "btn btn-ghost" %>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success">
    <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="alert alert-danger">
    <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<div class="card mb-6">
  <div class="card-body p-6">
    <div class="grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;">
      <div>
        <div class="text-sm text-muted mb-1">Joining Date</div>
        <div class="font-medium joining-date"><%= @employee.joining_date %></div>
      </div>
      <div>
        <div class="text-sm text-muted mb-1">Current Salary</div>
        <div class="font-medium employee-current-salary"><%= format_salary(@employee.current_salary, @employee.country) %></div>
      </div>
      <div>
        <div class="text-sm text-muted mb-1">Country</div>
        <div class="font-medium employee-country"><%= @employee.country.name %></div>
      </div>
      <div>
        <div class="text-sm text-muted mb-1">Department</div>
        <div class="font-medium employee-department"><%= @employee.department.name %></div>
      </div>
    </div>
  </div>
</div>

<div class="card table-card mb-6">
  <div class="card-header border-b border-color p-4 bg-gray-50">
    <h2 class="font-semibold text-lg m-0">Salary History</h2>
  </div>
  
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Effective Date</th>
          <th class="col-salary">Annual Salary</th>
        </tr>
      </thead>
      <tbody>
        <% if @salaries.empty? %>
          <tr>
            <td colspan="2" class="text-center empty-state salary-fallback">No salary records found for this employee.</td>
          </tr>
        <% else %>
          <% @salaries.each do |salary| %>
            <tr id="<%= dom_id(salary) %>">
              <td class="salary-effective-date"><%= salary.effective_from.strftime("%B %d, %Y") %></td>
              <td class="col-salary salary-amount"><%= format_salary(salary, @employee.country) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card table-card mb-6">
  <div class="card-header border-b border-color p-4 bg-gray-50">
    <h2 class="font-semibold text-lg m-0">Attendance History</h2>
  </div>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Period</th>
          <th>Working Days</th>
          <th>Present Days</th>
          <th>Absent Days</th>
        </tr>
      </thead>
      <tbody>
        <% if @attendances.empty? %>
          <tr>
            <td colspan="4" class="text-center empty-state attendance-empty-state">No attendance records available yet.</td>
          </tr>
        <% else %>
          <% @attendances.each do |attendance| %>
            <tr id="<%= dom_id(attendance) %>">
              <td class="font-medium attendance-period"><%= Date::MONTHNAMES[attendance.period.month] %> <%= attendance.period.year %></td>
              <td class="attendance-working-days"><%= attendance.working_days %></td>
              <td class="attendance-present-days"><%= attendance.present_days %></td>
              <td class="attendance-absent-days"><%= [attendance.working_days - attendance.present_days, 0].max %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card table-card">
  <div class="card-header border-b border-color p-4 bg-gray-50">
    <h2 class="font-semibold text-lg m-0">Monthly Salary &amp; Payment History</h2>
  </div>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Period</th>
          <th class="col-salary">Monthly Salary</th>
          <th class="col-salary">Payable Amount</th>
          <th>Payment Status</th>
        </tr>
      </thead>
      <tbody>
        <% if @monthly_salaries.empty? %>
          <tr>
            <td colspan="4" class="text-center empty-state monthly-salary-empty-state">No monthly salary records available yet.</td>
          </tr>
        <% else %>
          <% @monthly_salaries.each do |ms| %>
            <tr id="<%= dom_id(ms) %>">
              <td class="font-medium monthly-salary-period"><%= Date::MONTHNAMES[ms.period.month] %> <%= ms.period.year %></td>
              <td class="col-salary monthly-salary-base"><%= format_salary(ms.monthly_salary, @employee.country) %></td>
              <td class="col-salary font-medium monthly-salary-payable"><%= format_salary(ms.payable_amount, @employee.country) %></td>
              <td class="monthly-salary-status">
                <% if ms.status == MonthlySalary::STATUS_PAID %>
                  <span class="badge badge-success"><%= ms.status %></span>
                <% else %>
                  <span class="badge badge-warning"><%= ms.status %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

