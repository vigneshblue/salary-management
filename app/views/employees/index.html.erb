<% content_for :title, "Employees — ACME HR" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Employees</h1>
    <p class="page-subtitle">View and manage employee information</p>
  </div>
</div>

<%= form_with url: employees_path, method: :get, data: { turbo_frame: "employees_frame" }, class: "search-bar" do |f| %>
  <div class="search-bar-inner">
    <div class="search-input-wrap">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <%= f.text_field :q,
            value: @query,
            placeholder: "Search by name or employee ID…",
            class: "search-input",
            autocomplete: "off" %>
    </div>

    <%= f.select :country_id,
          options_from_collection_for_select(@countries, :id, :name, @country_id&.to_i),
          { include_blank: "All Countries" },
          class: "filter-select" %>

    <%= f.select :department_id,
          options_from_collection_for_select(@departments, :id, :name, @department_id&.to_i),
          { include_blank: "All Departments" },
          class: "filter-select" %>

    <%= f.submit "Search", class: "btn btn-primary" %>

    <% if @filter_params.any? %>
      <%= link_to "Clear", employees_path, class: "btn btn-ghost" %>
    <% end %>
  </div>
<% end %>

<%= turbo_frame_tag "employees_frame", data: { turbo_action: "advance" } do %>
  <div class="card table-card">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th class="col-index">#</th>
            <th>Employee ID</th>
            <th>Name</th>
            <th>Country</th>
            <th>Department</th>
            <th class="col-salary">Current Salary</th>
          </tr>
        </thead>
        <tbody>
          <% if @employees.empty? %>
            <tr>
              <td colspan="6" class="text-center empty-state">
                <% if @filter_params.any? %>
                  No employees match your search or filters.
                <% else %>
                  No employees found.
                <% end %>
              </td>
            </tr>
          <% else %>
            <% @employees.each_with_index do |employee, idx| %>
              <tr id="<%= dom_id(employee) %>">
                <td class="col-index text-muted"><%= (@page - 1) * @per_page + idx + 1 %></td>
                <td class="font-medium employee-number"><%= employee.employee_number %></td>
                <td class="employee-name">
                  <%= link_to employee.name, employee_path(employee), class: "font-medium text-primary hover:underline", data: { turbo_frame: "_top" } %>
                </td>
                <td class="employee-country"><%= employee.country.name %></td>
                <td class="employee-department"><%= employee.department.name %></td>
                <td class="col-salary employee-salary"><%= format_salary(employee.current_salary, employee.country) %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "pagination" %>
  </div>
<% end %>
