<% content_for :title, "Monthly Salary Processing — ACME HR" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Monthly Salaries</h1>
    <p class="page-subtitle">Calculate and process monthly salaries based on attendance</p>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success">
    <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="alert alert-danger">
    <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<div class="card mb-6">
  <div class="card-header border-b p-4 bg-gray-50">
    <h2 class="font-semibold text-lg m-0">Select Period & Actions</h2>
  </div>
  <div class="card-body p-6">
    <p class="text-muted mb-6">
      Select a period to calculate or process monthly salaries. Calculating salaries creates <strong>Pending</strong> records based on attendance and annual salary. Processing salaries transitions all eligible <strong>Pending</strong> records to <strong>Paid</strong> without recalculating or modifying amounts.
    </p>

    <div style="display: flex; gap: 24px; align-items: flex-end; flex-wrap: wrap;">
      <%= form_with url: monthly_salaries_path, method: :post, class: "attendance-form", local: true do |f| %>
        <div class="attendance-form-grid">
          <div class="form-group">
            <%= f.label :year, "Year", class: "form-label" %>
            <%= f.select :year,
                  options_for_select((2020..2030).to_a.reverse, @year),
                  {},
                  class: "filter-select w-full" %>
          </div>

          <div class="form-group">
            <%= f.label :month, "Month", class: "form-label" %>
            <%= f.select :month,
                  options_for_select((1..12).map { |m| [Date::MONTHNAMES[m], m] }, @month),
                  {},
                  class: "filter-select w-full" %>
          </div>

          <div class="form-group action-group">
            <%= f.submit "Calculate Salaries", class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>

      <% if @pending_count.positive? %>
        <%= form_with url: process_salaries_monthly_salaries_path, method: :post, local: true do |f| %>
          <%= f.hidden_field :year, value: @year %>
          <%= f.hidden_field :month, value: @month %>
          <div class="form-group action-group">
            <%= f.submit "Process Pending Salaries", class: "btn btn-success", style: "background-color: #10b981; border-color: #10b981; color: white;" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="card mb-6">
  <div class="card-header border-b p-4 bg-gray-50">
    <h2 class="font-semibold text-lg m-0">Period Summary: <%= Date::MONTHNAMES[@month] %> <%= @year %></h2>
  </div>
  <div class="card-body p-6">
    <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
      <div class="stat-card">
        <div class="text-sm text-muted mb-1">Total Employees in System</div>
        <div class="stat-value"><%= number_with_delimiter(@total_employees) %></div>
      </div>

      <div class="stat-card">
        <div class="text-sm text-muted mb-1">Attendance Status</div>
        <div class="stat-value">
          <%= number_with_delimiter(@attendances_count) %>
          <% if @total_employees.positive? && @attendances_count == @total_employees %>
            <span class="badge badge-success">Ready</span>
          <% elsif @attendances_count.positive? %>
            <span class="badge badge-warning">Incomplete</span>
          <% else %>
            <span class="badge badge-muted">Missing</span>
          <% end %>
        </div>
      </div>

      <div class="stat-card">
        <div class="text-sm text-muted mb-1">Salaries Calculated</div>
        <div class="stat-value">
          <%= number_with_delimiter(@salaries_count) %>
          <% if @total_employees.positive? && @salaries_count == @total_employees %>
            <span class="badge badge-success">Complete</span>
          <% elsif @salaries_count.positive? %>
            <span class="badge badge-warning">Partial</span>
          <% else %>
            <span class="badge badge-muted">Not Calculated</span>
          <% end %>
        </div>
      </div>

      <div class="stat-card">
        <div class="text-sm text-muted mb-1">Processing Status</div>
        <div class="stat-value">
          <% if @salaries_count.zero? %>
            <span class="badge badge-muted">Not Started</span>
          <% elsif @pending_count.zero? && @paid_count.positive? %>
            <span class="badge badge-success">All Paid</span>
          <% elsif @paid_count.zero? && @pending_count.positive? %>
            <span class="badge badge-warning">All Pending</span>
          <% else %>
            <span class="badge badge-warning">Mixed (<%= @paid_count %> Paid / <%= @pending_count %> Pending)</span>
          <% end %>
        </div>
      </div>
    </div>

    <% if @currency_totals.any? %>
      <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
        <h4 class="font-semibold text-sm text-muted mb-2" style="text-transform: uppercase; letter-spacing: 0.05em;">Total Payable by Currency</h4>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <% @currency_totals.each do |currency, total| %>
            <% paid_val = @currency_totals_paid[currency] || 0 %>
            <% pending_val = @currency_totals_pending[currency] || 0 %>
            <% symbol = EmployeesHelper::CURRENCY_SYMBOLS[currency] || "#{currency} " %>
            <div class="stat-card" style="min-width: 220px;">
              <div class="text-sm text-muted mb-1"><%= currency %> Total</div>
              <div class="stat-value font-medium" style="font-size: 18px;">
                <%= symbol %><%= number_with_precision(total, precision: 2, delimiter: ",") %>
              </div>
              <div class="text-sm text-muted" style="margin-top: 6px; font-size: 12px;">
                <span style="color: #10b981;">Paid: <%= symbol %><%= number_with_precision(paid_val, precision: 2, delimiter: ",") %></span>
                <% if pending_val.positive? %>
                  &bull; <span style="color: #f59e0b;">Pending: <%= symbol %><%= number_with_precision(pending_val, precision: 2, delimiter: ",") %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% if @sample_salaries.any? %>
  <div class="card table-card mb-6">
    <div class="card-header border-b p-4 bg-gray-50">
      <h3 class="font-semibold text-lg m-0">Sample Monthly Salary Preview (<%= Date::MONTHNAMES[@month] %> <%= @year %>)</h3>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Employee ID</th>
            <th>Name</th>
            <th>Country</th>
            <th>Department</th>
            <th class="col-salary">Monthly Base</th>
            <th class="col-salary">Payable Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% @sample_salaries.each do |ms| %>
            <tr id="<%= dom_id(ms) %>">
              <td class="font-medium employee-number"><%= ms.employee.employee_number %></td>
              <td><%= link_to ms.employee.name, employee_path(ms.employee), class: "font-medium text-primary hover:underline" %></td>
              <td><%= ms.employee.country.name %></td>
              <td><%= ms.employee.department.name %></td>
              <td class="col-salary"><%= format_salary(ms.monthly_salary, ms.employee.country) %></td>
              <td class="col-salary font-medium"><%= format_salary(ms.payable_amount, ms.employee.country) %></td>
              <td>
                <% if ms.status == MonthlySalary::STATUS_PAID %>
                  <span class="badge badge-success"><%= ms.status %></span>
                <% else %>
                  <span class="badge badge-warning"><%= ms.status %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% if @periods.any? %>
  <div class="card table-card">
    <div class="card-header border-b p-4 bg-gray-50">
      <h3 class="font-semibold text-lg m-0">All Recorded Periods</h3>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Period</th>
            <th>Year</th>
            <th>Month</th>
            <th>Salaries (Total / Paid / Pending)</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @periods.each do |p| %>
            <% p_total = p.monthly_salaries.count %>
            <% p_paid = p.monthly_salaries.where(status: MonthlySalary::STATUS_PAID).count %>
            <% p_pending = p.monthly_salaries.where(status: MonthlySalary::STATUS_PENDING).count %>
            <tr>
              <td class="font-medium"><%= Date::MONTHNAMES[p.month] %> <%= p.year %></td>
              <td><%= p.year %></td>
              <td><%= p.month %></td>
              <td>
                <%= number_with_delimiter(p_total) %>
                <% if p_total.positive? %>
                  <span class="text-muted" style="font-size: 12px;">(<%= p_paid %> Paid / <%= p_pending %> Pending)</span>
                <% end %>
              </td>
              <td>
                <%= link_to "View Period", monthly_salaries_path(year: p.year, month: p.month), class: "btn btn-ghost btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
