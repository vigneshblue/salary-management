<% content_for :title, "Monthly Salary Processing — ACME HR" %>

<div class="page-header" style="align-items: center; flex-wrap: wrap; gap: 16px;">
  <div>
    <h1 class="page-title">Monthly Salaries</h1>
    <p class="page-subtitle">Calculate, inspect, and process monthly salaries based on employee attendance</p>
  </div>

  <div>
    <%= form_with url: monthly_salaries_path, method: :get, local: true, class: "currency-selector-form" do |f| %>
      <%= f.hidden_field :year, value: @year %>
      <%= f.hidden_field :month, value: @month %>
      <%= f.hidden_field :q, value: @query if @query.present? %>
      <%= f.hidden_field :country_id, value: @country_id if @country_id.present? %>
      <%= f.hidden_field :department_id, value: @department_id if @department_id.present? %>
      <%= f.hidden_field :status, value: @status if @status.present? %>
      <div style="display: flex; align-items: center; gap: 8px;">
        <%= f.label :currency, "Reporting Currency:", class: "form-label m-0 font-medium", style: "white-space: nowrap;" %>
        <%= f.select :currency,
              options_for_select(@supported_currencies, @currency),
              {},
              class: "filter-select",
              style: "min-width: 100px; padding-top: 6px; padding-bottom: 6px;",
              onchange: "this.form.submit();" %>
        <noscript>
          <%= f.submit "Apply", class: "btn btn-primary btn-sm" %>
        </noscript>
      </div>
    <% end %>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success">
    <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="alert alert-danger">
    <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<div class="card mb-6">
  <div class="card-header border-b p-4 bg-gray-50" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
      <h2 class="font-semibold text-lg m-0">Select Period &amp; Actions</h2>
      <p class="text-muted text-sm m-0">Selected Period: <strong><%= Date::MONTHNAMES[@month] %> <%= @year %></strong></p>
    </div>
    <div>
      <%= link_to "← Go to Attendance", attendances_path(year: @year, month: @month), class: "btn btn-ghost btn-sm" %>
    </div>
  </div>
  <div class="card-body p-6">
    <p class="text-muted mb-6">
      Select a period to inspect, calculate, or process monthly salaries. Calculating salaries creates <strong>Pending</strong> records based on attendance and annual salary. Processing salaries transitions all eligible <strong>Pending</strong> records to <strong>Paid</strong> without recalculating or modifying amounts.
    </p>

    <div style="display: flex; gap: 24px; align-items: flex-end; flex-wrap: wrap;">
      <%= form_with url: monthly_salaries_path, method: :post, class: "attendance-form", local: true do |f| %>
        <div class="attendance-form-grid">
          <div class="form-group">
            <%= f.label :year, "Year", class: "form-label" %>
            <%= f.select :year,
                  options_for_select((2020..2030).to_a.reverse, @year),
                  {},
                  class: "filter-select w-full",
                  onchange: "window.location.href = '#{monthly_salaries_path}?year=' + this.value + '&month=' + document.getElementById('monthly_salary_month_select').value;" %>
          </div>

          <div class="form-group">
            <%= f.label :month, "Month", class: "form-label" %>
            <%= f.select :month,
                  options_for_select((1..12).map { |m| [Date::MONTHNAMES[m], m] }, @month),
                  {},
                  id: "monthly_salary_month_select",
                  class: "filter-select w-full",
                  onchange: "window.location.href = '#{monthly_salaries_path}?year=' + document.querySelector('select[name=\"year\"]').value + '&month=' + this.value;" %>
          </div>

          <div class="form-group action-group">
            <%= f.submit "Calculate Salaries", class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>

      <% if @pending_count.positive? %>
        <%= form_with url: process_salaries_monthly_salaries_path, method: :post, local: true do |f| %>
          <%= f.hidden_field :year, value: @year %>
          <%= f.hidden_field :month, value: @month %>
          <div class="form-group action-group">
            <%= f.submit "Process Pending Salaries", class: "btn btn-success", style: "background-color: #10b981; border-color: #10b981; color: white;" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="card mb-6">
  <div class="card-header border-b p-4 bg-gray-50">
    <h2 class="font-semibold text-lg m-0">Period Summary: <%= Date::MONTHNAMES[@month] %> <%= @year %></h2>
  </div>
  <div class="card-body p-6">
    <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
      <div class="stat-card">
        <div class="text-sm text-muted mb-1">Total Employees in System</div>
        <div class="stat-value"><%= number_with_delimiter(@total_employees) %></div>
      </div>

      <div class="stat-card">
        <div class="text-sm text-muted mb-1">Attendance Status</div>
        <div class="stat-value">
          <%= number_with_delimiter(@attendances_count) %>
          <% if @total_employees.positive? && @attendances_count == @total_employees %>
            <span class="badge badge-success">Ready</span>
          <% elsif @attendances_count.positive? %>
            <span class="badge badge-warning">Incomplete</span>
          <% else %>
            <span class="badge badge-muted">Missing</span>
          <% end %>
        </div>
      </div>

      <div class="stat-card">
        <div class="text-sm text-muted mb-1">Salaries Calculated</div>
        <div class="stat-value">
          <%= number_with_delimiter(@salaries_count) %>
          <% if @total_employees.positive? && @salaries_count == @total_employees %>
            <span class="badge badge-success">Complete</span>
          <% elsif @salaries_count.positive? %>
            <span class="badge badge-warning">Partial</span>
          <% else %>
            <span class="badge badge-muted">Not Calculated</span>
          <% end %>
        </div>
      </div>

      <div class="stat-card">
        <div class="text-sm text-muted mb-1">Processing Status</div>
        <div class="stat-value">
          <% if @salaries_count.zero? %>
            <span class="badge badge-muted">Not Started</span>
          <% elsif @pending_count.zero? && @paid_count.positive? %>
            <span class="badge badge-success">All Paid</span>
          <% elsif @paid_count.zero? && @pending_count.positive? %>
            <span class="badge badge-warning">All Pending</span>
          <% elsif @pending_count.zero? && @paid_count.zero? && @not_payable_count.positive? %>
            <span class="badge badge-muted">All Not Payable</span>
          <% else %>
            <span class="badge badge-warning">Mixed (<%= @paid_count %> Paid / <%= @pending_count %> Pending / <%= @not_payable_count %> Not Payable)</span>
          <% end %>
        </div>
      </div>
    </div>

    <% if @salaries_count.positive? %>
      <% curr_symbol = EmployeesHelper::CURRENCY_SYMBOLS[@currency] || "#{@currency} " %>
      <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
          <h4 class="font-semibold text-sm text-muted m-0" style="text-transform: uppercase; letter-spacing: 0.05em;">
            Total Payable Summary (Reporting in <%= @currency %>)
          </h4>
          <span class="text-sm text-muted">
            Total Converted: <strong style="color: var(--text-main);"><%= curr_symbol %><%= number_with_precision(@total_payable_converted, precision: 2, delimiter: ",") %></strong>
            (<span style="color: #10b981;">Paid: <%= curr_symbol %><%= number_with_precision(@total_paid_converted, precision: 2, delimiter: ",") %></span> &bull;
            <span style="color: #f59e0b;">Pending: <%= curr_symbol %><%= number_with_precision(@total_pending_converted, precision: 2, delimiter: ",") %></span>)
          </span>
        </div>

        <h4 class="font-semibold text-xs text-muted mb-2" style="text-transform: uppercase; letter-spacing: 0.05em;">Breakdown by Original Currency</h4>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <% @currency_totals.each do |currency, total| %>
            <% paid_val = @currency_totals_paid[currency] || 0 %>
            <% pending_val = @currency_totals_pending[currency] || 0 %>
            <% symbol = EmployeesHelper::CURRENCY_SYMBOLS[currency] || "#{currency} " %>
            <div class="stat-card" style="min-width: 200px;">
              <div class="text-sm text-muted mb-1"><%= currency %> Total</div>
              <div class="stat-value font-medium" style="font-size: 17px;">
                <%= symbol %><%= number_with_precision(total, precision: 2, delimiter: ",") %>
              </div>
              <div class="text-sm text-muted" style="margin-top: 6px; font-size: 12px;">
                <span style="color: #10b981;">Paid: <%= symbol %><%= number_with_precision(paid_val, precision: 2, delimiter: ",") %></span>
                <% if pending_val.positive? %>
                  &bull; <span style="color: #f59e0b;">Pending: <%= symbol %><%= number_with_precision(pending_val, precision: 2, delimiter: ",") %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# Filter & Search Controls %>
<%= form_with url: monthly_salaries_path, method: :get, data: { turbo_frame: "monthly_salaries_frame" }, class: "search-bar mb-6" do |f| %>
  <%= f.hidden_field :year, value: @year %>
  <%= f.hidden_field :month, value: @month %>
  <%= f.hidden_field :currency, value: @currency if @currency != CurrencyConverter::DEFAULT_CURRENCY %>
  <%# Reset page to 1 when filtering %>
  <%= hidden_field_tag :page, 1 %>

  <div class="search-bar-inner">
    <div class="search-input-wrap">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <%= f.text_field :q,
            value: @query,
            placeholder: "Search employee name or number…",
            class: "search-input",
            autocomplete: "off" %>
    </div>

    <%= f.select :country_id,
          options_from_collection_for_select(@countries, :id, :name, @country_id&.to_i),
          { include_blank: "All Countries" },
          class: "filter-select" %>

    <%= f.select :department_id,
          options_from_collection_for_select(@departments, :id, :name, @department_id&.to_i),
          { include_blank: "All Departments" },
          class: "filter-select" %>

    <%= f.select :status,
          options_for_select([
            ["All Payment Statuses", ""],
            ["Pending", MonthlySalary::STATUS_PENDING],
            ["Paid", MonthlySalary::STATUS_PAID],
            ["Not Payable", MonthlySalary::STATUS_NOT_PAYABLE]
          ], @status),
          {},
          class: "filter-select" %>

    <%= f.submit "Filter", class: "btn btn-primary" %>

    <% if @query.present? || @country_id.present? || @department_id.present? || @status.present? %>
      <%= link_to "Clear Filters", monthly_salaries_path(year: @year, month: @month, currency: (@currency if @currency != CurrencyConverter::DEFAULT_CURRENCY)), class: "btn btn-ghost" %>
    <% end %>
  </div>
<% end %>

<%# Full Paginated Monthly Salary Table %>
<%= turbo_frame_tag "monthly_salaries_frame", data: { turbo_action: "advance" } do %>
  <div class="card table-card mb-6">
    <div class="card-header border-b p-4 bg-gray-50" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <h3 class="font-semibold text-lg m-0">
        Monthly Salary Records (<%= Date::MONTHNAMES[@month] %> <%= @year %>)
      </h3>
      <% if @current_period && @salaries_count.positive? %>
        <span class="text-sm text-muted">
          Showing <%= number_with_delimiter(@from_index) %>–<%= number_with_delimiter(@to_index) %> of <%= number_with_delimiter(@total_count) %> filtered records (<%= number_with_delimiter(@salaries_count) %> total)
        </span>
      <% end %>
    </div>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th class="col-index">Emp No</th>
            <th>Name</th>
            <th>Country</th>
            <th>Department</th>
            <th class="col-salary">Monthly Base</th>
            <th style="text-align: right;">Working Days</th>
            <th style="text-align: right;">Present Days</th>
            <th style="text-align: right;">Absent Days</th>
            <th class="col-salary">Payable Salary</th>
            <th>Payment Status</th>
          </tr>
        </thead>
        <tbody>
          <% if @current_period.nil? || @salaries_count.zero? %>
            <tr>
              <td colspan="13" class="text-center empty-state">
                No monthly salaries have been calculated for <%= Date::MONTHNAMES[@month] %> <%= @year %>. Click "Calculate Salaries" above to compute compensation.
              </td>
            </tr>
          <% elsif @monthly_salaries.empty? %>
            <tr>
              <td colspan="13" class="text-center empty-state">
                No monthly salary records match your search or filter criteria.
              </td>
            </tr>
          <% else %>
            <% @monthly_salaries.each_with_index do |ms, idx| %>
              <%
                employee = ms.employee
                country = employee.country
                annual_sal = employee.current_salary(@as_of_date)&.annual_salary
                att = @attendances_by_emp_id[employee.id]
                working_d = att&.working_days || 0
                present_d = att&.present_days || 0
                absent_d = working_d.positive? ? [working_d - present_d, 0].max : 0
              %>
              <tr id="<%= dom_id(ms) %>">
                <td class="font-medium employee-number"><%= employee.employee_number %></td>
                <td class="employee-name">
                  <%= link_to employee.name, employee_path(employee), class: "font-medium text-primary hover:underline", data: { turbo_frame: "_top" } %>
                </td>
                <td class="employee-country"><%= country.name %></td>
                <td class="employee-department"><%= employee.department.name %></td>
                <td class="col-salary"><%= format_salary(ms.monthly_salary, country) %></td>
                <td style="text-align: right;"><%= working_d %></td>
                <td style="text-align: right;"><%= present_d %></td>
                <td style="text-align: right;"><%= absent_d %></td>
                <td class="col-salary font-medium"><%= format_salary(ms.payable_amount, country) %></td>
                <td>
                  <% if ms.status == MonthlySalary::STATUS_PAID %>
                    <span class="badge badge-success"><%= ms.status %></span>
                  <% elsif ms.status == MonthlySalary::STATUS_NOT_PAYABLE %>
                    <span class="badge badge-muted"><%= ms.status %></span>
                  <% else %>
                    <span class="badge badge-warning"><%= ms.status %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination", path_helper: :monthly_salaries_path, item_name: "records" %>
  </div>
<% end %>

<% if @periods.any? %>
  <div class="card table-card">
    <div class="card-header border-b p-4 bg-gray-50">
      <h3 class="font-semibold text-lg m-0">All Recorded Periods</h3>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Period</th>
            <th>Year</th>
            <th>Month</th>
            <th>Salaries (Total / Paid / Pending)</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @periods.each do |p| %>
            <% p_total = p.monthly_salaries.count %>
            <% p_paid = p.monthly_salaries.where(status: MonthlySalary::STATUS_PAID).count %>
            <% p_pending = p.monthly_salaries.where(status: MonthlySalary::STATUS_PENDING).count %>
            <tr>
              <td class="font-medium"><%= Date::MONTHNAMES[p.month] %> <%= p.year %></td>
              <td><%= p.year %></td>
              <td><%= p.month %></td>
              <td>
                <%= number_with_delimiter(p_total) %>
                <% if p_total.positive? %>
                  <span class="text-muted" style="font-size: 12px;">(<%= p_paid %> Paid / <%= p_pending %> Pending)</span>
                <% end %>
              </td>
              <td>
                <%= link_to "View Period", monthly_salaries_path(year: p.year, month: p.month), class: "btn btn-ghost btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
